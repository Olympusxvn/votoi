# Copy to .env and fill in. .env is gitignored and must never be pushed.

# Tatum: Sui gRPC gateway (primary chain transport) + Data APIs + webhooks
TATUM_API_KEY=
# Native gRPC host (host:port). Blank disables the tatum-grpc transport.
TATUM_SUI_GRPC_HOST=sui-mainnet-grpc.gateway.tatum.io:443
# Optional separate key for the gRPC gateway (defaults to TATUM_API_KEY)
TATUM_SUI_GRPC_KEY=
# Sui network reached through Tatum: mainnet or testnet
SUI_NETWORK=mainnet
# Legacy JSON-RPC gateway URL override (404s with this key; kept for recovery)
TATUM_SUI_RPC_URL=
# Public fallback endpoints (no key)
SUI_PUBLIC_GRPC_URL=https://fullnode.mainnet.sui.io:443
SUI_GRAPHQL_URL=https://graphql.mainnet.sui.io/graphql
TATUM_WEBHOOK_SECRET=
# Agent escrow account that signs automated x402 / MPP payments
VOTOI_AGENT_SUI_ADDRESS=
# Our own x402-compatible facilitator endpoint (Step 3); empty until deployed
VOTOI_X402_FACILITATOR_URL=

# Walrus Memory (MemWal). Delegate keypair created in the MemWal dashboard.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# Walrus blob vault (receipt evidence) + public reader
WALRUS_PUBLISHER_URL=https://publisher.walrus-mainnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-mainnet.walrus.space

# Neon Postgres fast cache tier (use the -pooler host for pooled connections)
DATABASE_URL=

# Pricing override (else Tatum Data API, else CoinGecko)
SUI_USD_RATE=

# Chat model (OpenAI-compatible). Empty key = deterministic composer answers.
# LLM_BASE_URL defaults to https://api.openai.com/v1; LLM_MODEL defaults to gpt-4o-mini.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Background dream interval in ms (0 disables). Bills ride the same tick
# unless BILLPAY_AUTO_RUN=false.
COMPACTION_INTERVAL_MS=600000
BILLPAY_AUTO_RUN=true

# Chat model (OpenAI-compatible). Unset = deterministic composer answers.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
