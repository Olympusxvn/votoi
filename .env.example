# Copy to .env and fill in. .env is gitignored and must never be pushed.

# Tatum (Sui RPC + webhooks + simulator)
TATUM_API_KEY=
# Sui network reached through the Tatum RPC gateway: mainnet or testnet
SUI_NETWORK=mainnet
# Optional overrides (defaults are derived from SUI_NETWORK)
TATUM_SUI_RPC_URL=
# Our own x402-compatible facilitator endpoint (Step 3); empty until deployed
VOTOI_X402_FACILITATOR_URL=
TATUM_WEBHOOK_SECRET=
# Agent escrow account that signs automated x402 / MPP payments
VOTOI_AGENT_SUI_ADDRESS=

# Walrus Memory (MemWal). Delegate keypair created in the MemWal dashboard.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Neon Postgres fast cache tier (use the -pooler host for pooled connections)
DATABASE_URL=
